alse,"mocked":false,"inspired":false,"smiteNext":false,"raging":false,"marked":null}},"hero":{"set":{"dir":3,"level":3,"xp":1510,"nextXp":2028,"abilities":["attack","cleave","secondwind","potion","lampejo"],"maxHp":28,"atk":7,"hp":28,"x":1392,"y":504,"glow":{"r":30,"c":[160,200,255],"a":0.35,"h":18},"hidden":false,"bonusAtk":2,"mocked":false,"inspired":false,"smiteNext":false,"raging":false,"marked":null}},"travessia:0":{"set":{"hp":0,"moveLeft":5,"action":1,"bonus":1,"sneakUsed":false,"attackedThisTurn":false}},"travessia:1":{"set":{"dir":0,"speed":120,"hp":0,"x":368,"y":442,"moveLeft":1,"action":1,"bonus":1,"sneakUsed":false,"attackedThisTurn":true}},"travessia:2":{"set":{"hp":0}},"travessia:3":{"set":{"hp":0}},"travessia:4":{"set":{"hp":0}},"travessia:5":{"set":{"hp":0}},"travessia:6":{"set":{"hp":0}},"travessia:7":{"set":{"hp":0}},"travessia:8":{"set":{"name":"Odara, a Pena-Cinza","fixed":false}},"travessia:9":{"set":{"hidden":false,"hp":0}},"travessia:10":{"set":{"hidden":false,"hp":0}},"travessia:11":{"set":{"hidden":false,"hp":0}}},"objects":{"travessia:o6":{"set":{"hidden":false}}},"groups":{"vale:patrol":{"ids":["vale:0","vale:1","vale:2"],"passive":true},"vale:ruins":{"ids":["vale:3","vale:4","vale:5","vale:6"],"passive":true},"travessia:procissao":{"ids":["travessia:0","travessia:1","travessia:2","travessia:3"],"passive":true},"travessia:cacadores":{"ids":["travessia:4","travessia:5","travessia:6","travessia:7"],"passive":true},"travessia:murta":{"ids":["travessia:9","travessia:10","travessia:11"],"passive":true}},"g":{"party":[{"$u":"hero"},{"$u":"lyra"}],"followers":[],"leader":0,"hero":{"$u":"hero"},"mate":{"$u":"lyra"},"potions":1,"gold":127,"f":{"avo_dead":true,"smoke_out":true,"maren_aboard":true,"maren_forgot":true,"tome_alive":true,"awake":true,"dream_done":true,"echo":"accepted","escape_done":true,"escape":true,"act1":true,"rosalva_met":true,"note":true,"eco_trade":"refused","rested1":true,"gate_busy":false,"gate_passed":true,"trav_entered":true,"proc":"fight","ambush":true,"murta":"fought","hunters":"won","ch1_done":true},"items":[{"id":"letter","name":"Carta do Contrato","icon":"letter","desc":"Selada com uma pena de sabiá. O lacre tem o desenho de uma torre.","read":"<p><i>Ao portador desta:</i></p><p>sob as Ruínas de Velmoor, no vale de Brumafolha, dorme algo que não pode ser esquecido. Traga-o a Vau-de-Cardo, à taverna do Sabiá Cego, e receba trezentas peças.</p><p>Não abra o que encontrar. Não escute o que ele disser.</p><p class='sig'>— L.</p>"},{"id":"chair","name":"Cadeira do Otávio","icon":"chair","desc":"Uma cadeira de balanço. No encosto, entalhado à faca, com um talho em forma de anzol: \"Para a Maren, do teu Otávio\"."},{"id":"note","name":"Recado de L.","icon":"feather","desc":"Um bilhete dobrado em quatro, preso com uma pena cinzenta.","read":"<p><i>Se você lê isto, eu não pude esperar.</i></p><p>A Coroa pôs preço na marca. Não mostre a mão a ninguém, nem a quem sorri. Minha mensageira aguarda do outro lado do vau, na Travessia do Cardo, até a lua nova.</p><p>O que você carrega escuta. Não conte a ele o que eu contei a você.</p><p class='sig'>— L.</p>"},{"id":"shield:escudo:oa3ot","gear":"shield","key":"escudo","name":"Escudo de madeira","icon":"shield","desc":"+2 de CA. Ocupa a outra mão."},{"id":"seal","name":"Sinete dos Lembradores","icon":"seal","desc":"Cera cinzenta com uma pena e uma torre. A mensageira disse: mostre isto no Mosteiro, só a quem perguntar pela Página em Branco."}],"memories":[{"id":"dream","text":"A cidade branca do sonho, e a mulher de prata.","origin":false},{"id":"o1","text":"Quem me ensinou a ser quem eu sou: minha mãe, Ana.","origin":true},{"id":"o2","text":"O lugar que eu chamo de casa: a estrada.","origin":true},{"id":"sunset","text":"O pôr do sol no Lago Espelhado.","origin":false},{"id":"odara","text":"Odara, a Pena-Cinza, esfregando os pulsos: \"L. foi convidado a descansar.\"","origin":false}],"approval":{},"clock":9.168891111111142,"clockTarget":13,"tint":null,"ambient":null,"musicOverride":{"$undef":1},"speedCap":null,"tutorial":false,"hintsSeen":{"$set":[]},"origin":{"$undef":1},"advNext":{"$undef":1},"followLeader":{"$undef":1},"campaign":"c-mwl3fxcy-rkz7t","playTime":9.5999},"story":{"esc":{"R":-48,"hold":0,"stop":false,"ending":false,"fires":[]},"timers":[],"tweens":[]},"moment":{"kind":"explore"}}}